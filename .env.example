# Shotcheck — configurazione ambiente

# Chiave segreta per firmare i cookie di sessione (genera con: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Database SQLite (percorso file, resta sul VPS)
DATABASE_URL=sqlite:///./storage/shotcheck.db

# Cloudflare R2 (storage foto, S3-compatible) — dashboard Cloudflare > R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shotcheck-photos
# Endpoint dedotto da R2_ACCOUNT_ID se lasciato vuoto: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Durata in secondi degli URL firmati con cui il backend serve le foto
R2_PRESIGNED_TTL=900

# SendGrid (email transazionali) — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
EMAIL_FROM=notifiche@tuodominio.it
# Email dello studio/admin che riceve le notifiche di nuove note/rifiuti
ADMIN_EMAIL=

# URL pubblico del sito (usato nei link nelle email)
BASE_URL=http://localhost:8000

# API key dedicata per upload machine-to-machine da Scout (non credenziali utente)
SCOUT_API_KEY=
